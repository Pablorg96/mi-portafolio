<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pablo Romero — UX/UI Designer & Productor Audiovisual</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="#" class="logo">Pablo Romero</a>
            <ul class="nav-links">
                <li><a href="#inicio">Inicio</a></li>
                <li><a href="#casos">Casos</a></li>
                <li><a href="#servicios">Servicios</a></li>
                <li><a href="#contacto">Contacto</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero -->
    <section id="inicio" class="hero">
        <div class="hero-content">
            <h1 class="hero-title">
                <span class="line"><span class="words">UX/UI Designer &</span></span>
                <span class="line"><span class="words">Productor Audiovisual</span></span>
                <span class="line"><span class="words">Senior</span></span>
            </h1>
            <p class="hero-subtitle">Diseño, vídeo y tecnología. Creo experiencias digitales coherentes que comunican, emocionan y generan impacto.</p>
            <a href="#contacto" class="cta-btn">Hablemos</a>
        </div>
    </section>

<!-- Video Reel -->
<div class="video-sticky-container">
    <div class="video-wrapper">
        <video id="heroVideo" autoplay muted loop playsinline>
            <source src="videos/MYHIXEL_Ring.mp4" type="video/mp4">
        </video>
    </div>
</div>

    <!-- Logos Carrusel -->
    <section class="logos-section" id="logosSection">
        <div class="container">
            <p class="logos-label">He trabajado con</p>
            <div class="logos-carousel">
                <div class="logos-track">
                    <div class="logo-item">
                        <img src="logos/Atresmedia.png" alt="Atresmedia">
                    </div>
                    <div class="logo-item">
                        <img src="logos/MHX-marca-madre-RGB.png" alt="MYHIXEL">
                    </div>
                    <div class="logo-item">
                        <img src="logos/farmacia_pedro_salvador.png" alt="Farmacia Pedro Salvador">
                    </div>
                    <div class="logo-item">
                        <img src="logos/MYKODE_R.png" alt="MYKODE">
                    </div>
                    <!-- Duplicados para efecto infinito -->
                    <div class="logo-item">
                        <img src="logos/Atresmedia.png" alt="Atresmedia">
                    </div>
                    <div class="logo-item">
                        <img src="logos/MHX-marca-madre-RGB.png" alt="MYHIXEL">
                    </div>
                    <div class="logo-item">
                        <img src="logos/farmacia_pedro_salvador.png" alt="Farmacia Pedro Salvador">
                    </div>
                    <div class="logo-item">
                        <img src="logos/MYKODE_R.png" alt="MYKODE">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Casos de Estudio -->
    <section id="casos" class="casos-estudio">
        <div class="container">
            <div class="section-header">
                <h2>Casos de Estudio</h2>
                <p>Proyectos que muestran el resultado de estrategia, creatividad y ejecución integral.</p>
            </div>
            
            <div class="casos-grid">
                <!-- Caso 1 -->
                <div class="caso-card" onclick="abrirModal(0)">
                    <div class="caso-imagen">
                        <img src="images/myhixel_ring.jpg" alt="MYHIXEL Ring">
                        <div class="caso-overlay">
                            <span class="play-btn">▶</span>
                        </div>
                    </div>
                    <h3>MYHIXEL Ring</h3>
                    <p>Lanzamiento de Producto Kickstarter</p>
                </div>

                <!-- Caso 2 -->
                <div class="caso-card" onclick="abrirModal(1)">
                    <div class="caso-imagen">
                        <img src="images/myhixel_iii.jpg" alt="MYHIXEL Trainer">
                        <div class="caso-overlay">
                            <span class="play-btn">▶</span>
                        </div>
                    </div>
                    <h3>MYHIXEL Trainer</h3>
                    <p>Campaña Kickstarter Estrella</p>
                </div>

                <!-- Caso 3 -->
                <div class="caso-card" onclick="abrirModal(2)">
                    <div class="caso-imagen">
                        <img src="images/cuidado_intimo.jpg" alt="Cuidado Íntimo">
                        <div class="caso-overlay">
                            <span class="play-btn">▶</span>
                        </div>
                    </div>
                    <h3>Línea Cuidado Íntimo</h3>
                    <p>Campaña Atresmedia</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal -->
    <div id="modal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="cerrarModal()">&times;</span>
            <div class="modal-video">
                <iframe id="modalVideo" width="100%" height="600" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="modal-info">
                <h2 id="modalTitle"></h2>
                <p id="modalDesc"></p>
            </div>
        </div>
    </div>

    <!-- Trabajos -->
    <section class="trabajos">
        <div class="container">
            <div class="section-header">
                <h2>Servicios Principales</h2>
                <p>Ofrezco soluciones creativas integrales que conectan diseño, vídeo y tecnología.</p>
            </div>
            <div class="trabajos-grid">
                <div class="trabajo-item">
                    <div class="trabajo-image">🎨</div>
                    <h3>UX/UI & Diseño Digital</h3>
                    <p>Diseño de producto y aplicaciones móviles. Arquitectica de información, flujos, wireframes e interfaces intuitivas que funcionan.</p>
                </div>
                <div class="trabajo-item">
                    <div class="trabajo-image">🎬</div>
                    <h3>Producción Audiovisual</h3>
                    <p>Campañas 360º, dirección audiovisual y producción de contenido. Experiencia en broadcasts (Atresmedia) y campañas de alto impacto.</p>
                </div>
                <div class="trabajo-item">
                    <div class="trabajo-image">✨</div>
                    <h3>Branding & Diseño Gráfico</h3>
                    <p>Sistemas visuales, branding, packaging y comunicación digital. Desde la conceptualización hasta la ejecución final.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="servicios">
        <div class="container">
            <div class="section-header">
                <h2>Qué ofrezco</h2>
                <p>Servicios creados para resolver desafíos específicos de diseño, producción y comunicación.</p>
            </div>
            <div class="servicios-grid">
                <div class="servicio-card">
                    <div class="servicio-number">01</div>
                    <h3>Estrategia UX/UI</h3>
                    <p>Definición de arquitectura, flujos de usuario, wireframes e interfaces funcionales. Desde apps móviles hasta plataformas SaaS.</p>
                    <a href="#contacto" class="servicio-link">Saber más →</a>
                </div>
                <div class="servicio-card">
                    <div class="servicio-number">02</div>
                    <h3>Producción Audiovisual</h3>
                    <p>Concepto, dirección, producción y post-producción. Campañas comerciales, content creativo para redes y narrativa audiovisual.</p>
                    <a href="#contacto" class="servicio-link">Saber más →</a>
                </div>
                <div class="servicio-card">
                    <div class="servicio-number">03</div>
                    <h3>Branding & Diseño</h3>
                    <p>Identidad visual, sistemas de diseño, packaging y dirección de arte. Comunicación visual que diferencia y conecta.</p>
                    <a href="#contacto" class="servicio-link">Saber más →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonios -->
    <section class="testimonios">
        <div class="container">
            <div class="section-header">
                <h2>Lo que dicen mis clientes</h2>
            </div>
            <div class="testimonios-grid">
                <div class="testimonio-card">
                    <p class="testimonio-text">"Pablo entiende perfectamente cómo conectar diseño y audiovisual. Su visión 360º transforma proyectos ordinarios en experiencias memorables."</p>
                    <div class="testimonio-autor">
                        <strong>Cliente</strong>
                        <span>Proyecto</span>
                    </div>
                </div>
                <div class="testimonio-card">
                    <p class="testimonio-text">"Trabajar con alguien que domina tantas disciplinas es raro. Pablo no solo ejecuta, entiende la estrategia detrás de cada proyecto."</p>
                    <div class="testimonio-autor">
                        <strong>Cliente</strong>
                        <span>Proyecto</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sobre mí -->
    <section class="sobre">
        <div class="container">
            <div class="sobre-content">
                <h2>Sobre mí</h2>
                <p>Soy UX/UI Designer, Productor Audiovisual Senior y Diseñador Gráfico basado en Sevilla. Vengo del mundo de la Publicidad y las Relaciones Públicas, con un máster en Diseño Gráfico que me formó para entender cómo comunicar visualmente.</p>
                <p>Hace años descubrí que el diseño, el vídeo y la tecnología no son disciplinas aisladas. Son piezas de un mismo puzzle. Ahora mi trabajo consiste en unirlas para crear experiencias coherentes, con sentido y que generen impacto real.</p>
                <p>En MYHIXEL he especializado mi experiencia en dirección audiovisual, diseño de producto y campañas 360º. He liderado proyectos con cifras destacadas en Kickstarter (+$2.3M recaudados) y producciones emitidas en Atresmedia. También integro IA generativa en mis procesos para optimizar creatividad sin perder calidad.</p>
                <p>En paralelo, creo Cromántiko, un proyecto personal donde diseño e ilustro mensajes sociales que se plasman en serigrafía artesanal.</p>
                <p>Creo que el diseño y el audiovisual no solo venden: comunican, emocionan y cambian cosas. Por eso busco seguir creciendo y trabajar en proyectos que tengan propósito.</p>
                <div class="skills">
                    <h3>Herramientas & Tecnologías</h3>
                    <div class="skills-list">
                        <span>Figma</span>
                        <span>Adobe XD</span>
                        <span>Premiere Pro</span>
                        <span>After Effects</span>
                        <span>Photoshop</span>
                        <span>Illustrator</span>
                        <span>InDesign</span>
                        <span>IA Generativa</span>
                        <span>GA4</span>
                        <span>Meta Ads</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="contacto">
        <div class="container">
            <div class="contacto-content">
                <h2>Hablemos</h2>
                <p>¿Tienes un proyecto con propósito? Me encantaría escucharte y explorar cómo podemos trabajar juntos.</p>
                <div class="contacto-links">
                    <a href="mailto:pablorg16@gmail.com" class="contacto-btn">Email</a>
                    <a href="https://www.linkedin.com/in/pablo-romero-garduno/" class="contacto-btn" target="_blank">LinkedIn</a>
                    <a href="https://www.instagram.com/pablorg96/" class="contacto-btn" target="_blank">Instagram</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 Pablo Romero. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="script.js"></script>
</body>
</html>
