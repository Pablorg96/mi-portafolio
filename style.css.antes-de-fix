.cta-btn {
    display: inline-block;
    padding: 16px 40px;
    background-color: var(--black);
    color: var(--white);
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    animation: fadeInUp 0.4s ease-out 0.3s forwards !important;
    opacity: 0;
}

.cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Hero Subtitle - Sincronizado */
.hero p {
    font-size: 18px;
    color: var(--gray-text);
    margin-bottom: 40px;
    line-height: 1.8;
    animation: fadeSlideIn 0.4s ease-out 0s forwards !important;
}

@keyframes fadeSlideIn {
    0% { 
        opacity: 0; 
        transform: translateX(30px); 
    }
    100% { 
        opacity: 1; 
        transform: translateX(0); 
    }
}

/* Hero Title */
.hero h1 .words {
    animation: blurFadeUp 0.4s ease-out forwards;
}

.hero h1 .line:nth-child(1) .words { animation-delay: 0s; }
.hero h1 .line:nth-child(2) .words { animation-delay: 0.1s; }
.hero h1 .line:nth-child(3) .words { animation-delay: 0.2s; }

@keyframes blurFadeUp {
    0% {
        filter: blur(16px);
        transform: translateY(20px);
        opacity: 0;
    }
    100% {
        filter: blur(0);
        transform: translateY(0);
        opacity: 1;
    }
}
