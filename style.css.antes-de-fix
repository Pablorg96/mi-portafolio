.line:nth-child(2) .words { animation-delay: 0.08s; }
.line:nth-child(3) .words { animation-delay: 0.16s; }

@keyframes blurFadeUp {
    0% {
        filter: blur(16px);
        transform: translateY(20px);
        opacity: 0;
    }
    100% {
        filter: blur(0);
        transform: translateY(0);
        opacity: 1;
    }
}

