* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --black: #000000;
    --white: #ffffff;
    --gray: #f5f5f5;
    --gray-text: #666666;
    --gray-border: #e0e0e0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
    background-color: var(--white);
    color: var(--black);
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
}

/* Navbar */
.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: var(--white);
    border-bottom: 1px solid var(--gray-border);
    z-index: 1000;
    padding: 20px 0;
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    color: var(--black);
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 50px;
}

.nav-links a {
    font-size: 14px;
    text-decoration: none;
    color: var(--gray-text);
    transition: color 0.3s ease;
}

.nav-links a:hover {
    color: var(--black);
}

/* Logos Carrusel */
.logos-section {
    padding: 80px 0;
    border-top: 1px solid var(--gray-border);
    border-bottom: 1px solid var(--gray-border);
    background-color: var(--white);
    overflow: hidden;
}

.logos-label {
    text-align: center;
    font-size: 12px;
    color: var(--gray-text);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 40px;
    padding: 0 40px;
}

.logos-carousel {
    width: 100%;
    overflow: hidden;
    background-color: var(--white);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
}

.logos-track {
    display: flex;
    gap: 80px;
    animation: scrollLogos 18s linear infinite;
    will-change: transform;
    padding: 0 40px;
}

.logo-item {
    flex-shrink: 0;
    width: 180px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
}

.logo-item:nth-child(1) { animation-delay: 0.1s; }
.logo-item:nth-child(2) { animation-delay: 0.2s; }
.logo-item:nth-child(3) { animation-delay: 0.3s; }
.logo-item:nth-child(4) { animation-delay: 0.4s; }
.logo-item:nth-child(5) { animation-delay: 0.5s; }
.logo-item:nth-child(6) { animation-delay: 0.6s; }
.logo-item:nth-child(7) { animation-delay: 0.7s; }
.logo-item:nth-child(8) { animation-delay: 0.8s; }

.logo-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
}

.logo-item:hover img {
    filter: grayscale(0%);
}

@keyframes scrollLogos {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

/* Section Header */
.section-header {
    text-align: center;
    margin-bottom: 80px;
}

.section-header h2 {
    font-size: 48px;
    margin-bottom: 20px;
    line-height: 1.2;
}

.section-header p {
    font-size: 16px;
    color: var(--gray-text);
    max-width: 600px;
    margin: 0 auto;
}

/* Casos de Estudio Grid */
.casos-estudio {
    padding: 120px 40px;
}

.casos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 40px;
}

.caso-card {
    cursor: pointer;
    transition: all 0.3s ease;
}

.caso-card:hover {
    transform: translateY(-5px);
}

.caso-imagen {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 1;
    margin-bottom: 25px;
}

.caso-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.caso-card:hover .caso-imagen img {
    transform: scale(1.05);
}

.caso-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.caso-card:hover .caso-overlay {
    opacity: 1;
}

.play-btn {
    width: 60px;
    height: 60px;
    background: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: var(--black);
    transition: all 0.3s ease;
}

.caso-card:hover .play-btn {
    transform: scale(1.1);
}

.caso-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
}

.caso-card p {
    font-size: 14px;
    color: var(--gray-text);
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    overflow: auto;
    padding: 20px;
}

.modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background-color: var(--white);
    border-radius: 12px;
    width: 100%;
    max-width: 1000px;
    overflow: hidden;
    animation: slideIn 0.3s ease;
}

.modal-video {
    width: 100%;
    background-color: var(--black);
    aspect-ratio: 16 / 9;
}

.modal-video iframe {
    width: 100%;
    height: 100%;
}

.modal-info {
    padding: 40px;
}

.modal-info h2 {
    font-size: 28px;
    margin-bottom: 15px;
    font-weight: 600;
}

.modal-info p {
    font-size: 15px;
    color: var(--gray-text);
    line-height: 1.8;
}

.close {
    position: absolute;
    right: 30px;
    top: 30px;
    font-size: 32px;
    font-weight: bold;
    color: var(--white);
    cursor: pointer;
    transition: color 0.3s ease;
    z-index: 2001;
}

.close:hover {
    color: var(--gray-text);
}

/* Trabajos */
.trabajos {
    padding: 120px 40px;
    background-color: var(--gray);
}

.trabajos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 60px;
}

.trabajo-item {
    transition: all 0.3s ease;
}

.trabajo-item:hover {
    transform: translateY(-5px);
}

.trabajo-image {
    font-size: 60px;
    margin-bottom: 30px;
}

.trabajo-item h3 {
    font-size: 20px;
    margin-bottom: 15px;
    font-weight: 600;
}

.trabajo-item p {
    font-size: 14px;
    color: var(--gray-text);
    line-height: 1.8;
}

/* Servicios */
.servicios {
    padding: 120px 40px;
}

.servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 50px;
}

.servicio-card {
    background-color: var(--gray);
    padding: 50px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.servicio-card:hover {
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    transform: translateY(-5px);
}

.servicio-number {
    font-size: 32px;
    font-weight: 700;
    color: var(--gray-text);
    margin-bottom: 20px;
}

.servicio-card h3 {
    font-size: 22px;
    margin-bottom: 15px;
    font-weight: 600;
}

.servicio-card p {
    font-size: 14px;
    color: var(--gray-text);
    margin-bottom: 30px;
    line-height: 1.8;
}

.servicio-link {
    font-size: 14px;
    color: var(--black);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
}

.servicio-link:hover {
    color: var(--gray-text);
    margin-left: 5px;
}

/* Testimonios */
.testimonios {
    padding: 120px 40px;
    background-color: var(--gray);
}

.testimonios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
}

.testimonio-card {
    padding: 40px;
    border: 1px solid var(--gray-border);
    border-radius: 8px;
    background-color: var(--white);
    transition: all 0.3s ease;
}

.testimonio-card:hover {
    border-color: var(--black);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.testimonio-text {
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 30px;
    font-style: italic;
    color: var(--black);
}

.testimonio-autor {
    display: flex;
    flex-direction: column;
}

.testimonio-autor strong {
    font-size: 14px;
    font-weight: 600;
}

.testimonio-autor span {
    font-size: 12px;
    color: var(--gray-text);
}

/* Sobre */
.sobre {
    padding: 120px 40px;
}

.sobre-content {
    max-width: 800px;
}

.sobre-content h2 {
    font-size: 48px;
    margin-bottom: 30px;
}

.sobre-content p {
    font-size: 16px;
    color: var(--gray-text);
    margin-bottom: 30px;
    line-height: 1.8;
}

.skills {
    margin-top: 50px;
}

.skills h3 {
    font-size: 18px;
    margin-bottom: 20px;
    font-weight: 600;
}

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.skills-list span {
    padding: 8px 16px;
    background-color: var(--gray);
    border: 1px solid var(--gray-border);
    border-radius: 4px;
    font-size: 13px;
    color: var(--gray-text);
}

/* Contacto */
.contacto {
    padding: 120px 40px;
    text-align: center;
    background-color: var(--gray);
}

.contacto-content h2 {
    font-size: 48px;
    margin-bottom: 20px;
}

.contacto-content p {
    font-size: 16px;
    color: var(--gray-text);
    margin-bottom: 50px;
}

.contacto-links {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.contacto-btn {
    padding: 12px 30px;
    background-color: var(--black);
    color: var(--white);
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.contacto-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

/* Footer */
.footer {
    padding: 40px;
    border-top: 1px solid var(--gray-border);
    text-align: center;
}

.footer p {
    font-size: 12px;
    color: var(--gray-text);
}

/* Animaciones */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Aparición vaporosa: difuminado + desplazamiento de abajo hacia arriba */
60% {
        filter: blur(4px);
    }
    to {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* Responsive */
@media (max-width: 768px) {
    .container {
        padding: 0 20px;
    }

    .nav-container {
        padding: 0 20px;
    }

    .nav-links {
        gap: 20px;
        font-size: 12px;
    }

    .hero {
        padding: 80px 20px;
        margin-top: 60px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero p {
        font-size: 16px;
    }

    .section-header h2 {
        font-size: 32px;
    }

    /* Logos más rápido en móvil */
    .logos-track {
        gap: 40px;
        animation: scrollLogos 12s linear infinite;
        padding: 0 20px;
    }

    .logo-item {
        width: 120px;
        height: 80px;
    }

    .casos-grid {
        grid-template-columns: 1fr;
    }

    .trabajos-grid,
    .servicios-grid,
    .testimonios-grid {
        grid-template-columns: 1fr;
    }

    .logos-label {
        padding: 0 20px;
    }
}

/* Video Reel */
.video-sticky-container {
    position: relative;
    height: 180vh; /* carril de scroll: cuanto mayor, más dura el efecto */
    background-color: #ffffff; /* GSAP lo animará hacia negro */
}

.video-wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 80px;
    box-sizing: border-box;
}

.video-wrapper video {
    width: 100%;
    height: 80vh;
    max-width: 1400px;
    object-fit: cover;
    display: block;
    transform-origin: center center;
    border-radius: 16px;
}

.logos-section {
    position: relative;
    z-index: 2;
    border-radius: 32px 32px 0 0;
    box-shadow: 0 -30px 60px rgba(0, 0, 0, 0.15);
}

@media (max-width: 768px) {
    .video-wrapper {
        padding: 0 20px;
    }
    .video-wrapper video {
        height: 50vh;
    }
}

.line {
    display: block;
    overflow: hidden;
    height: auto;
}

.words {
    display: inline-block;
    font-size: 64px;
    font-weight: 700;
    color: var(--black);
    animation: clipPathReveal 0.8s cubic-bezier(0.77, 0, 0.175, 1) forwards;
    transform-origin: left center;
}

.line:nth-child(1) .words {
    animation-delay: 0s;
}

.line:nth-child(2) .words {
    animation-delay: 0.3s;
}

.line:nth-child(3) .words {
    animation-delay: 0.6s;
}

@keyframes clipPathReveal {
    0% {
        clip-path: inset(0 100% 0 0);
        transform: translateY(20px);
        opacity: 0;
    }
    100% {
        clip-path: inset(0 0 0 0);
        transform: translateY(0);
        opacity: 1;
    }
}

/* CTA Button */
.cta-btn {
    display: inline-block;
    padding: 16px 40px;
    background-color: var(--black);
    color: var(--white);
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    animation: fadeInUp 0.8s ease 1.2s forwards;
    opacity: 0;
}

.cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}


