* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --black: #000000;
    --white: #ffffff;
    --gray: #f5f5f5;
    --gray-text: #666666;
    --gray-border: #e0e0e0;
}

html {
    scroll-behavior: smooth;
    overflow-x: hidden;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
    background-color: var(--white);
    color: var(--black);
    line-height: 1.6;
    overflow-x: hidden;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
}

/* Navbar */
.navbar {
    position: fixed;
    top: 20px;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
}

.logo-pill {
    pointer-events: auto;
    background-color: var(--white);
    padding: 12px 22px;
    border-radius: 999px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    color: var(--black);
}

.pill-nav {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    background-color: var(--white);
    border-radius: 999px;
    padding: 6px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.pill-indicator {
    position: absolute;
    top: 6px;
    left: 6px;
    height: calc(100% - 12px);
    width: 0;
    background-color: #FF6529;
    border-radius: 999px;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                width 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 1;
}

.nav-links {
    position: relative;
    z-index: 2;
    display: flex;
    list-style: none;
    gap: 2px;
}

.nav-links a {
    position: relative;
    display: block;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: var(--gray-text);
    border-radius: 999px;
    white-space: nowrap;
    transition: color 0.3s ease;
}

.nav-links a:hover {
    color: var(--black);
}

.nav-links a.active {
    color: var(--white);
}

/* Hero */
.hero {
    margin-top: 80px;
    padding: 100px 40px 60px;
    text-align: left;
    min-height: 90vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
}

.hero-content {
    max-width: 1120px;
    width: 100%;
    margin: 0 auto;
}

/* Logos Carrusel */
.logos-section {
    padding: 40px 0 20px;
    background-color: var(--white);
    overflow: hidden;
}

.logos-label {
    text-align: center;
    font-size: 12px;
    color: var(--gray-text);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 40px;
    padding: 0 40px;
}

.logos-carousel {
    width: 100%;
    overflow: hidden;
    background-color: var(--white);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
}

.logos-track {
    display: flex;
    gap: 80px;
    animation: scrollLogos 18s linear infinite;
    will-change: transform;
    padding: 0 40px;
}

.logo-item {
    flex-shrink: 0;
    width: 180px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
}

.logo-item:nth-child(1) { animation-delay: 0.1s; }
.logo-item:nth-child(2) { animation-delay: 0.2s; }
.logo-item:nth-child(3) { animation-delay: 0.3s; }
.logo-item:nth-child(4) { animation-delay: 0.4s; }
.logo-item:nth-child(5) { animation-delay: 0.5s; }
.logo-item:nth-child(6) { animation-delay: 0.6s; }
.logo-item:nth-child(7) { animation-delay: 0.7s; }
.logo-item:nth-child(8) { animation-delay: 0.8s; }

.logo-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
}

.logo-item:hover img {
    filter: grayscale(0%);
}

@keyframes scrollLogos {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

/* Section Header */
.section-header {
    text-align: center;
    margin-bottom: 80px;
}

.section-header h2 {
    font-size: 48px;
    margin-bottom: 20px;
    line-height: 1.2;
}

.section-header p {
    font-size: 16px;
    color: var(--gray-text);
    max-width: 600px;
    margin: 0 auto;
}

/* Proyectos Destacados Grid */
.casos-estudio {
    padding: 40px 40px 120px;
}

.casos-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 60px;
}

.casos-title {
    font-size: 56px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
}

.casos-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--black);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--black);
    transition: opacity 0.3s ease;
}

.casos-link:hover {
    opacity: 0.6;
}

.casos-link .arrow {
    font-size: 16px;
}

.casos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 32px;
}

.caso-card {
    cursor: pointer;
    transition: all 0.3s ease;
}

.caso-card:hover {
    transform: translateY(-5px);
}

.caso-imagen {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    aspect-ratio: 3 / 2;
    margin-bottom: 18px;
}

.caso-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.caso-card:hover .caso-imagen img {
    transform: scale(1.05);
}

.caso-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.caso-card:hover .caso-overlay {
    opacity: 1;
}

.play-btn {
    width: 60px;
    height: 60px;
    background: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: var(--black);
    transition: all 0.3s ease;
}

.caso-card:hover .play-btn {
    transform: scale(1.1);
}

.caso-card h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 4px;
}

.caso-card p {
    font-size: 14px;
    color: var(--gray-text);
    margin: 0;
}

/* Animación de aparición al hacer scroll (mismo estilo que el titular del Hero) */
.reveal-blur {
    opacity: 0;
    filter: blur(16px);
    transform: translateY(40px);
}

@media (max-width: 768px) {
    .casos-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }

    .casos-title {
        font-size: 36px;
    }
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    overflow: auto;
    padding: 20px;
}

.modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background-color: var(--white);
    border-radius: 12px;
    width: 100%;
    max-width: 1000px;
    overflow: hidden;
    animation: slideIn 0.3s ease;
}

.modal-video {
    width: 100%;
    background-color: var(--black);
    aspect-ratio: 16 / 9;
}

.modal-video iframe {
    width: 100%;
    height: 100%;
}

.modal-info {
    padding: 40px;
}

.modal-info h2 {
    font-size: 28px;
    margin-bottom: 15px;
    font-weight: 600;
}

.modal-info p {
    font-size: 15px;
    color: var(--gray-text);
    line-height: 1.8;
}

.close {
    position: absolute;
    right: 30px;
    top: 30px;
    font-size: 32px;
    font-weight: bold;
    color: var(--white);
    cursor: pointer;
    transition: color 0.3s ease;
    z-index: 2001;
}

.close:hover {
    color: var(--gray-text);
}

/* Trabajos */
.trabajos {
    padding: 120px 40px;
    background-color: var(--gray);
}

.trabajos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 60px;
}

.trabajo-item {
    transition: all 0.3s ease;
}

.trabajo-item:hover {
    transform: translateY(-5px);
}

.trabajo-image {
    font-size: 60px;
    margin-bottom: 30px;
}

.trabajo-item h3 {
    font-size: 20px;
    margin-bottom: 15px;
    font-weight: 600;
}

.trabajo-item p {
    font-size: 14px;
    color: var(--gray-text);
    line-height: 1.8;
}

/* Servicios */
.servicios {
    padding: 120px 40px;
}

.servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 50px;
}

.servicio-card {
    background-color: var(--gray);
    padding: 50px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.servicio-card:hover {
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    transform: translateY(-5px);
}

.servicio-number {
    font-size: 32px;
    font-weight: 700;
    color: var(--gray-text);
    margin-bottom: 20px;
}

.servicio-card h3 {
    font-size: 22px;
    margin-bottom: 15px;
    font-weight: 600;
}

.servicio-card p {
    font-size: 14px;
    color: var(--gray-text);
    margin-bottom: 30px;
    line-height: 1.8;
}

.servicio-link {
    font-size: 14px;
    color: var(--black);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
}

.servicio-link:hover {
    color: var(--gray-text);
    margin-left: 5px;
}

/* Testimonios */
.testimonios {
    padding: 120px 40px;
    background-color: var(--gray);
}

.testimonios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
}

.testimonio-card {
    padding: 40px;
    border: 1px solid var(--gray-border);
    border-radius: 8px;
    background-color: var(--white);
    transition: all 0.3s ease;
}

.testimonio-card:hover {
    border-color: var(--black);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.testimonio-text {
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 30px;
    font-style: italic;
    color: var(--black);
}

.testimonio-autor {
    display: flex;
    flex-direction: column;
}

.testimonio-autor strong {
    font-size: 14px;
    font-weight: 600;
}

.testimonio-autor span {
    font-size: 12px;
    color: var(--gray-text);
}

/* Sobre */
.sobre {
    padding: 120px 40px;
}

.sobre-content {
    max-width: 800px;
}

.sobre-content h2 {
    font-size: 48px;
    margin-bottom: 30px;
}

.sobre-content p {
    font-size: 16px;
    color: var(--gray-text);
    margin-bottom: 30px;
    line-height: 1.8;
}

.skills {
    margin-top: 50px;
}

.skills h3 {
    font-size: 18px;
    margin-bottom: 20px;
    font-weight: 600;
}

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.skills-list span {
    padding: 8px 16px;
    background-color: var(--gray);
    border: 1px solid var(--gray-border);
    border-radius: 4px;
    font-size: 13px;
    color: var(--gray-text);
}

/* Contacto */
.contacto {
    padding: 120px 40px;
    text-align: center;
    background-color: var(--gray);
}

.contacto-content h2 {
    font-size: 48px;
    margin-bottom: 20px;
}

.contacto-content p {
    font-size: 16px;
    color: var(--gray-text);
    margin-bottom: 50px;
}

.contacto-links {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.contacto-btn {
    padding: 12px 30px;
    background-color: var(--black);
    color: var(--white);
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.contacto-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

/* Footer */
.footer {
    padding: 40px;
    text-align: center;
}

.footer p {
    font-size: 12px;
    color: var(--gray-text);
}

/* Animaciones */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* Responsive */
@media (max-width: 768px) {
    .container {
        padding: 0 20px;
    }

    .navbar {
        padding: 0 16px;
        top: 12px;
    }

    .logo-pill {
        display: none;
    }

    .pill-nav {
        padding: 4px;
    }

    .nav-links {
        gap: 0;
    }

    .nav-links a {
        padding: 8px 14px;
        font-size: 12px;
    }

    .hero {
        padding: 80px 20px;
        margin-top: 60px;
        min-height: auto;
    }

    .hero-title {
        font-size: 40px;
    }

    .hero-subtitle {
        font-size: 16px;
    }

    .section-header h2 {
        font-size: 32px;
    }

    /* Logos más rápido en móvil */
    .logos-track {
        gap: 40px;
        animation: scrollLogos 12s linear infinite;
        padding: 0 20px;
    }

    .logo-item {
        width: 120px;
        height: 80px;
    }

    .casos-grid {
        grid-template-columns: 1fr;
    }

    .trabajos-grid,
    .servicios-grid,
    .testimonios-grid {
        grid-template-columns: 1fr;
    }

    .logos-label {
        padding: 0 20px;
    }

    .video-wrapper {
        padding: 0 20px;
    }

    .video-wrapper video {
        height: 50vh;
    }
}

/* Video Reel */
.video-sticky-container {
    position: relative;
    height: 180vh; /* carril de scroll: cuanto mayor, más dura el efecto */
    background-color: #ffffff; /* GSAP lo animará hacia negro */
}

.video-wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 80px;
    box-sizing: border-box;
}

.video-wrapper video {
    width: 100%;
    height: 80vh;
    max-width: 1400px;
    object-fit: cover;
    display: block;
    transform-origin: center center;
    border-radius: 16px;
}

.logos-section {
    position: relative;
    z-index: 2;
    border-radius: 32px 32px 0 0;
}

/* Hero title reveal */
.line {
    display: block;
    height: auto;
    padding-bottom: 8px;
}

.words {
    display: inline-block;
    font-size: 80px;
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--black);
    transform-origin: left center;
}

.hero-title {
    line-height: 1.08;
    margin-bottom: 24px;
}

.hero-title .words {
    animation: blurFadeUp 0.4s ease-out forwards;
    opacity: 0;
}
@keyframes blurFadeUp {
    0% {
        filter: blur(16px);
        transform: translateY(20px);
        opacity: 0;
    }
    100% {
        filter: blur(0);
        transform: translateY(0);
        opacity: 1;
    }
}


.hero-title .line:nth-child(1) .words { animation-delay: 0s; }
.hero-title .line:nth-child(2) .words { animation-delay: 0.1s; }
.hero-title .line:nth-child(3) .words { animation-delay: 0.2s; }

.hero-subtitle,
.hero p {
    font-size: 18px;
    color: var(--gray-text);
    margin-bottom: 40px;
    line-height: 1.8;
    animation: fadeInFromRight 0.9s ease 0.2s both;
}

@keyframes fadeInFromRight {
    from {
        opacity: 0;
        transform: translateX(40px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.cta-btn {
    display: inline-block;
    padding: 16px 40px;
    background-color: var(--black);
    color: var(--white);
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    animation: fadeInUp 0.6s ease 0.5s both;
}

.cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

@keyframes underlineReveal {
    0% {
        width: 0;
        left: 0;
    }
    100% {
        width: 100%;
        left: 0;
    }
}

/* Overview Section */
.overview-section {
    padding: 40px 40px 20px;
    background-color: var(--white);
    position: relative;
}

.overview-label { display: none; }

.overview-wrapper {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 60px;
}

.overview-title {
    font-size: 56px;
    line-height: 1.15;
    font-weight: 400;
    margin-bottom: 0;
    max-width: 800px;
    flex: 1;
}

.overview-words {
    display: block;
}

.highlight-text {
    position: relative;
    display: inline-block;
    white-space: nowrap;
}

.highlight-text::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 0;
    height: 3px;
    background-color: #FF8C00;
}

.highlight-text.animated::after {
    width: 100%;
    transition: width 0.6s ease-out;
}

.overview-link {
    position: relative;
    font-size: 15px;
    font-weight: 600;
    color: var(--black);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 6px;
    white-space: nowrap;
    flex-shrink: 0;
}

.overview-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #FF8C00;
    transition: width 0.4s cubic-bezier(0.77, 0, 0.175, 1);
}

.overview-link:hover::after {
    width: 100%;
}

@media (max-width: 768px) {
    .overview-section {
        padding: 80px 20px;
    }

    .overview-wrapper {
        flex-direction: column;
        align-items: flex-start;
        gap: 40px;
        margin-bottom: 40px;
    }

    .overview-title {
        font-size: 32px;
    }

    .overview-link {
        margin-top: 20px;
    }
}


/* Servicios Interactive Section */
.servicios-interactive {
    padding: 80px 40px;
    background-color: var(--white);
}

.servicios-title {
    font-size: 56px;
    font-weight: 700;
    margin-bottom: 60px;
    line-height: 1.1;
}

.servicios-list {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.servicio-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 40px 0;
    border-bottom: 1px solid var(--gray-border);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.77, 0, 0.175, 1);
    position: relative;
    overflow: hidden;
    background-color: var(--white);
    color: var(--black);
}

.servicio-row:last-child {
    border-bottom: none;
}

.servicio-left {
    flex: 1;
}

.servicio-nombre {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
    transition: color 0.4s ease;
}

.servicio-right {
    flex-shrink: 0;
    text-align: right;
    margin-left: 40px;
}

.servicio-tags {
    font-size: 12px;
    color: var(--gray-text);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    transition: color 0.4s ease;
}

/* Estado Hover */




.servicio-expand {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.77, 0, 0.175, 1);
    position: absolute;
    bottom: -20px;
    left: 0;
    right: 0;
    padding: 0 40px;
}



.servicio-expand p {
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
    color: inherit;
}

/* Mouse Follower Image */
.servicio-image {
    position: fixed;
    width: 280px;
    aspect-ratio: 3 / 4;
    background-size: cover;
    background-position: center;
    border-radius: 20px;
    opacity: 0;
    pointer-events: none;
    z-index: 100;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    transition: opacity 0.3s ease;
}



@media (max-width: 768px) {
    .servicios-interactive {
        padding: 60px 20px;
    }

    .servicios-title {
        font-size: 36px;
        margin-bottom: 40px;
    }

    .servicio-row {
        padding: 30px 0;
        flex-direction: column;
        align-items: flex-start;
    }

    .servicio-nombre {
        font-size: 28px;
    }

    .servicio-right {
        text-align: left;
        margin-left: 0;
        margin-top: 12px;
    }

    .servicio-image {
        width: 200px;
        display: none;
    }
}


/* About Section (3 columnas + tilt 3D) */
.about-section {
    background-color: #F4F4F0;
    color: #1A1A1A;
    padding: 120px 40px;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 60px;
    align-items: stretch;
}

.about-col {
    display: flex;
    flex-direction: column;
}

.about-col-left {
    justify-content: space-between;
}

.about-hola {
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: #1A1A1A;
}

.about-summary {
    font-size: 16px;
    line-height: 1.7;
    color: #1A1A1A;
    max-width: 320px;
}

.about-col-center {
    display: flex;
    align-items: center;
    justify-content: center;
}

.about-photo-tilt {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 3 / 4;
    perspective: 1000px;
}

.about-photo-card {
    width: 100%;
    height: 100%;
}

.flip-card {
    background-color: transparent;
    border: none;
    box-shadow: none;
    width: 100%;
    height: 100%;
    perspective: 1000px;
}

.about-photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
}

.about-col-right {
    justify-content: center;
}

.about-detail {
    font-size: 18px;
    line-height: 1.8;
    color: #1A1A1A;
}

.about-detail strong {
    font-weight: 700;
}

@media (max-width: 900px) {
    .about-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .about-hola {
        font-size: 48px;
    }

    .about-summary {
        max-width: 100%;
    }

    .about-photo-tilt {
        max-width: 280px;
        margin: 0 auto;
    }
}

@media (max-width: 768px) {
    .about-section {
        padding: 80px 20px;
    }
}


/* Scroll Reveal 3D - Tarjeta de la foto */
.about-photo-tilt {
    opacity: 0;
    transform: perspective(1000px) translateY(80px) rotateX(15deg) rotateY(-10deg);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.about-photo-tilt.visible {
    opacity: 1;
    transform: perspective(1000px) translateY(0) rotateX(0) rotateY(0);
}


/* About - Flip Card 3D: la foto se da la vuelta al hacer hover, revelando el sello */
.about-photo-card {
    position: relative;
}

.flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.4, 0.2, 0.2, 1);
    transform-style: preserve-3d;
}

.flip-card:hover .flip-card-inner {
    transform: rotateY(180deg);
}

.flip-card-front,
.flip-card-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
}

.flip-card-front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
}

.flip-card-back {
    background-color: #302E2E;
    transform: rotateY(180deg);
    display: flex;
    align-items: center;
    justify-content: center;
}

.about-photo-badge {
    position: relative;
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.badge-rotate {
    position: absolute;
    top: 0;
    left: 0;
    animation: badgeRotate 10s linear infinite;
}

@keyframes badgeRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.badge-arrow {
    position: relative;
    z-index: 2;
}


/* About - Ajustes del badge circular (v2) */
.about-photo-badge text {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
    font-weight: 700;
}


/* About - Flecha flotando (v3) */
.badge-arrow {
    animation: floatArrow 2s ease-in-out infinite alternate;
}

@keyframes floatArrow {
    from { transform: translateY(-4px); }
    to { transform: translateY(4px); }
}


/* About - la tarjeta de la foto ahora es un enlace a Contacto */
.about-photo-tilt {
    text-decoration: none;
    cursor: pointer;
}


/* Fix móvil: evitar que el texto de Overview se salga de la pantalla */
@media (max-width: 768px) {
    .highlight-text {
        white-space: normal;
    }

    .overview-title,
    .overview-words {
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
}


/* Servicios interactivos en móvil: al tocar, texto + foto aparecen debajo */
@media (max-width: 768px) {
    .servicio-row {
        cursor: pointer;
    }

    .servicio-expand {
        position: static;
        max-height: 0;
        opacity: 0;
        margin-top: 0;
        overflow: hidden;
        transition: max-height 0.4s ease, opacity 0.4s ease, margin-top 0.4s ease;
    }

    .servicio-row.mobile-active {
        background-color: var(--black);
        color: var(--white);
    }

    .servicio-row.mobile-active .servicio-nombre,
    .servicio-row.mobile-active .servicio-tags {
        color: var(--white);
    }

    .servicio-row.mobile-active .servicio-expand {
        max-height: 600px;
        opacity: 1;
        margin-top: 16px;
    }

    .servicio-image {
        position: static;
        display: none;
        width: 100%;
        height: 220px;
        margin-top: 16px;
        opacity: 1;
        box-shadow: none;
    }

    .servicio-row.mobile-active .servicio-image {
        display: block;
    }
}


/* Servicios móvil (v2): mostrar la foto completa, sin recortar */
@media (max-width: 768px) {
    .servicio-image {
        background-size: contain;
        background-repeat: no-repeat;
        background-color: var(--gray);
        height: 240px;
    }
}


/* Servicios móvil (v3): mismo formato vertical (3:4) que en escritorio */
@media (max-width: 768px) {
    .servicio-image {
        width: 100%;
        max-width: 280px;
        height: auto;
        aspect-ratio: 3 / 4;
        margin: 16px auto 0;
        background-size: contain;
        background-repeat: no-repeat;
        background-color: var(--gray);
    }
}


/* Estados :hover solo para dispositivos con ratón real (evita el "doble toque" en iOS) */
@media (hover: hover) and (pointer: fine) {
.servicio-row:hover {
    background-color: var(--black);
    color: var(--white);
    padding: 40px;
    margin: 0 -40px;
    padding-left: 40px;
    padding-right: 40px;
}

.servicio-row:hover .servicio-nombre,
.servicio-row:hover .servicio-tags {
    color: var(--white);
}

.servicio-row:hover .servicio-expand {
    max-height: 200px;
    opacity: 1;
    bottom: 0;
    position: relative;
    margin-top: 20px;
}

.servicio-row:hover .servicio-image {
    opacity: 1;
}
}


/* Servicios móvil (v4): rellenar el marco sin bordes (cover en vez de contain) */
@media (max-width: 768px) {
    .servicio-image {
        background-size: cover;
    }
}


/* Servicios móvil: el fondo negro llega hasta los bordes reales de la pantalla */
@media (max-width: 768px) {
    .servicio-row.mobile-active {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        padding-left: 20px;
        padding-right: 20px;
        border-radius: 0;
    }
}
